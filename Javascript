const inputField = document.getElementById('inputArray');
const generateBtn = document.getElementById('generateBtn');
const sortBtn = document.getElementById('sortBtn');
const resetBtn = document.getElementById('resetBtn');
const barsContainer = document.getElementById('barsContainer');
const statusText = document.getElementById('statusText');

let array = [];
let isSorting = false;

// Generate random array
generateBtn.onclick = () => {
  if (isSorting) return;
  array = Array.from({ length: 20 }, () => Math.floor(Math.random() * 200) + 10);
  renderArray(array);
  statusText.innerText = 'Random array generated!';
};

// Reset array
resetBtn.onclick = () => {
  if (isSorting) return;
  array = [];
  barsContainer.innerHTML = '';
  statusText.innerText = 'Ready to visualize!';
};

// Parse input array
function parseInput() {
  const input = inputField.value.trim();
  if (!input) return [];
  return input.split(',').map(num => parseInt(num.trim())).filter(n => !isNaN(n));
}

// Render array as bars
function renderArray(arr, highlights = {}) {
  barsContainer.innerHTML = '';
  for (let i = 0; i < arr.length; i++) {
    const bar = document.createElement('div');
    bar.classList.add('bar');
    if (highlights.min) {
      if (i === highlights.min) bar.classList.add('min');
    }
    if (highlights.current) {
      if (i === highlights.current) bar.classList.add('current');
    }
    if (highlights.compared) {
      if (i === highlights.compared) bar.classList.add('compared');
    }
    bar.style.height = `${arr[i]}px`;
    barsContainer.appendChild(bar);
  }
}

// Delay helper
function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

// Selection sort with visualization
async function selectionSortVisual(arr) {
  isSorting = true;
  statusText.innerText = 'Sorting in progress...';

  const n = arr.length;
  for (let i = 0; i < n; i++) {
    let minIdx = i;
    renderArray(arr, { min: minIdx, current: i });
    await sleep(500);

    for (let j = i + 1; j < n; j++) {
      renderArray(arr, { min: minIdx, current: i, compared: j });
      await sleep(300);
      if (arr[j] < arr[minIdx]) {
        minIdx = j;
        renderArray(arr, { min: minIdx, current: i });
        await sleep(300);
      }
    }

    // Swap
    [arr[i], arr[minIdx]] = [arr[minIdx], arr[i]];
    renderArray(arr, { min: minIdx, current: i });
    await sleep(500);
  }

  renderArray(arr);
  statusText.innerText = 'Array sorted!';
  isSorting = false;
}

// Main button event
sortBtn.onclick = () => {
  if (isSorting) return;
  let userArray = parseInput();
  if (userArray.length === 0) {
    statusText.innerText = 'Please enter valid numbers or generate a random array!';
    return;
  }
  array = [...userArray];
  renderArray(array);
  selectionSortVisual(array);
};
